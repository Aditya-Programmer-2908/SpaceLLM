# ── HuggingFace ──────────────────────────────────────────────────────────────
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_REPO_ID=AdityaPS/SpaceLLM_v1
HF_ORG=AdityaPS

# ── Model ─────────────────────────────────────────────────────────────────────
BASE_MODEL_ID=openai/gpt-oss-20b
DEVICE_MAP=auto
LOAD_IN_4BIT=false
MAX_NEW_TOKENS=512
TEMPERATURE=0.7
TOP_P=0.9

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=spacellm.db

# ── MAPE-K Thresholds ─────────────────────────────────────────────────────────
MIN_FEEDBACK_FOR_RETRAIN=20
MIN_NEG_RATIO=0.3
BERTSCORE_THRESHOLD=0.82
RETRAIN_SCHEDULE_HOURS=24

# ── Training ──────────────────────────────────────────────────────────────────
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
TRAIN_EPOCHS=3
TRAIN_BATCH_SIZE=2
GRADIENT_ACCUM=4
LEARNING_RATE=2e-5
WARMUP_STEPS=50
OUTPUT_DIR=lora_checkpoints

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5500","http://127.0.0.1:5500"]
